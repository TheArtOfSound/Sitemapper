{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sitemapper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ORIGIN": "https://sitemapper.oortstack.com",
    "AUTH_DEV_LOGIN": "0",
    "RESEND_FROM": "Sitemapper <hello@oortstack.com>",
    "OPERATOR_EMAIL": "bryanleonard237@gmail.com",
    "GOOGLE_QUOTA_PROJECT": "sitemapper-gsc",
    "STRIPE_PRICE_AGENCY_ANNUAL": "price_1U60g3GeDvPZG3ZHlaYucvll",
    "STRIPE_PRICE_AGENCY_MONTHLY": "price_1U60g3GeDvPZG3ZHMstDxXnY",
    "STRIPE_PRICE_PRO_ANNUAL": "price_1U60g2GeDvPZG3ZHwvx3ARlo",
    "STRIPE_PRICE_PRO_MONTHLY": "price_1U60g1GeDvPZG3ZHAbEs5p8x",
    "STRIPE_PRICE_BUILDER_ANNUAL": "price_1U60g0GeDvPZG3ZH0RL84jjR",
    "STRIPE_PRICE_BUILDER_MONTHLY": "price_1U60g0GeDvPZG3ZHUSug1wSr"
  },
  "routes": [
    {
      "pattern": "sitemapper.oortstack.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SITEMAPPER_STATS",
      "id": "5223923adf504df69cada831e14d2b9e"
    },
    {
      "binding": "SITEMAPPER_RATE",
      "id": "d0b8a073eb0f4d569d461cabf4c7e7ec"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sitemapper",
      "database_id": "0f9731ce-2b90-4e39-9119-4be92fe4adbe",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "sitemapper-snapshots"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CRAWLS",
        "queue": "sitemapper-crawls"
      }
    ],
    "consumers": [
      {
        "queue": "sitemapper-crawls",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "sitemapper-crawls-dlq"
      }
    ]
  }
}
